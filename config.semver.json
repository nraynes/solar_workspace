{
    "changelog_location": "CHANGELOG.md",
    "commit_changes": true,
    "generate_changelog": true,
    "git_auth_method": "GITHUB",
    "log_level": "DEBUG",
    "major_changes": {
        "changes": [
            {
                "kind": "BREAKING CHANGES",
                "pattern": "^(.|\n)*BREAKING CHANGE(.|\n)*$",
                "priority": 1
            }
        ]
    },
    "minor_changes": {
        "changes": [
            {
                "kind": "Features",
                "pattern": "^feat(.|\n)*$",
                "priority": 2
            }
        ]
    },
    "other_changes": {
        "changes": [
            {
                "kind": "Maintenance Items",
                "pattern": "^chore(.|\n)*$",
                "priority": 4
            },
            {
                "kind": "Documentation",
                "pattern": "^docs(.|\n)*$",
                "priority": 5
            }
        ]
    },
    "patch_changes": {
        "changes": [
            {
                "kind": "Patches",
                "pattern": "^fix(.|\n)*$",
                "priority": 3
            }
        ]
    },
    "plugin_location": ".release",
    "plugins": {
        "semver-cargo": {
            "act_on_no_update": false,
            "publish": true,
            "set_version": true
        }
    },
    "push_changes": true,
    "release_branch": "master"
}